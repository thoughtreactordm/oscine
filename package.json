{
  "name": "oscine",
  "version": "1.0.0-rc.3",
  "description": "A format-first local music player for large libraries",
  "author": {
    "name": "Michael DeLally",
    "email": "thoughtreactor@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "palettes": "node scripts/make-palettes.mjs",
    "verify:native": "node scripts/check-native-abi.mjs",
    "seed:synthetic": "node scripts/seed-synthetic-library.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "probe:m1-exit": "node scripts/m1-exit-probe.mjs",
    "probe:m2-exit": "node scripts/m2-exit-probe.mjs",
    "probe:r1-fallback": "node scripts/r1-fallback-probe.mjs",
    "probe:replaygain": "node scripts/replaygain-worker-probe-run.mjs",
    "probe:media-session": "node scripts/media-session-probe.mjs",
    "probe:fixture": "node scripts/make-probe-fixture.mjs",
    "probe:m2-fixture": "node scripts/make-m2-probe-fixture.mjs",
    "probe:writeback-corpus": "node scripts/writeback-corpus-probe.mjs",
    "probe:writeback-fixture": "node scripts/make-writeback-corpus.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "better-sqlite3": "^13.0.1",
    "music-metadata": "^11.14.0",
    "node-web-audio-api": "^2.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/ui": "^4.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/typescript-plugin": "^3.3.8",
    "@vueuse/core": "^14.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "node-taglib-sharp": "^6.0.3",
    "pinia": "^3.0.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.5"
  }
}
